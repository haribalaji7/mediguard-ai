# ── Server Configuration ───────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────
# MongoDB Atlas connection string. App runs with mock data if omitted.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/mediguard-ai

# ── Authentication ─────────────────────────────────────────────
# REQUIRED — at least 8 characters. The app will NOT start without this.
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRY=30m
JWT_REFRESH_EXPIRY=7d

# ── AI ─────────────────────────────────────────────────────────
# Google Gemini API key (get one at https://aistudio.google.com/apikey).
# App uses rule-based fallback analysis if omitted.
GEMINI_API_KEY=your-gemini-api-key

# ── Client ─────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
